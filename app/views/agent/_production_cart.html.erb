<div id="product_cart_<%= model.product_id %>" class="right-badge">
<% if model.can_select? %>
  <%=
    button_to(
      { action: 'show', id: model.id, **extra_options },
      params: params.permit(:dispatch, :station_id, :desk_id, :client_id, :contact_id).compact_blank,
      class: 'button is-small is-primary'
    ) do
  %>
    <%= svg_tag 'cart-plus', class: 'icon' %>
  <% end %>
  <% items = cart.find_items(model.product.production_ids, **params.permit(:dispatch, :produce_on, :scene_id)) %>
  <% if items.present? %>
    <span class="tag is-badge is-danger"><%= items.size %></span>
  <% end %>
<% elsif cart %>
  <%=
    render(
      partial: 'cart_item_big',
      locals: {
        item: cart.init_cart_item(params, good_id: model.id),
        cart: cart,
        item_con: item_con,
        renew: { "product_cart_#{model.product_id}" => 'production_cart' }
      }
    )
  %>
<% end %>
</div>
