<% items = cart.find_items(model.product.production_ids, **(defined?(cart_options) ? cart_options : {})) %>

<div id="product_cart_<%= model.product_id %>" class="right-badge">
<% if model.can_select? %>
  <%=
    button_to(
      { action: 'show', id: model.id, **extra_options },
      params: defined?(cart_options) ? cart_options : {},
      class: 'button is-small is-primary'
    ) do
  %>
    <%= svg_tag 'cart-plus', class: 'icon' %>
  <% end %>
  <% if items.present? %>
    <span class="tag is-badge is-danger"><%= items.size %></span>
  <% end %>
<% elsif cart %>
  <%=
    render(
      partial: 'cart_item_big',
      locals: {
        item: cart.init_cart_item(params, good_id: model.id),
        cart: cart,
        item_con: item_con,
        renew: { "product_cart_#{model.product_id}" => { 'partial' => 'production_cart' } }
      }
    )
  %>
<% end %>
</div>
