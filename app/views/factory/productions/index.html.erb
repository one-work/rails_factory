<div class="column">
  <%# render 'taxon_bar' %>
  <div class="cards is-4">
    <%=
      render(
        partial: 'production_cart',
        layout: 'card',
        collection: @productions,
        as: :model,
        locals: {
          cart: @cart,
          item_con: 'trade/my/items',
          extra_options: { controller: controller_path },
          cart_options: { **params.permit(:dispatch, :produce_on, :scene_id, :desk_id, :station_id, :client_id, :contact_id), **session.to_h.slice('desk_id', 'station_id') }
        }
      )
    %>
  </div>

  <%= paginate @productions %>
</div>
<div class="column is-one-fifth">
  <%= render partial: 'cart_nav', locals: { cart: @cart, cart_con: 'trade/my/carts', order_con: 'trade/my/orders' } if @cart %>
</div>
