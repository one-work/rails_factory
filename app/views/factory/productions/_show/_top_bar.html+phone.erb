<div data-controller="mini-program" class="as-bar">
  <button id="history-button" data-controller="history" data-action="history#back" class="left">
    <%= svg_tag 'angle-left', kind: 'regular', class: 'icon is-small text-link' %>
  </button>
  <div class="bar-title truncate"><%= @production.title %></div>
  <%= button_to({ action: 'actions' }, form: { class: 'right' }) do %>
    <%= svg_tag 'ellipsis-vertical' %>
  <% end %>
</div>
