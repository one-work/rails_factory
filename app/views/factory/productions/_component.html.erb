<div
  data-controller="custom"
  data-custom-component-value="<%= component.id %>"
  id="component_<%= component.id %>"
  class="box is-narrow"
>
  <div class="text-grey">
    <span><%= component.name %></span>
    <span class="size-7"><%= component.select_str %></span>
    <span data-custom-target="tip" class="size-7 text-danger display-none"><%= component.select_str %></span>
  </div>
  <% if component.multiple %>
    <div class="no-disabled">
      <%=
        render(
          partial: 'component_part_number',
          collection: component_parts,
          as: :component_part,
          locals: { component: component }
        )
      %>
    </div>
  <% else %>
    <div class="buttons are-small no-disabled mt-3">
      <%=
        render(
          partial: 'component_part',
          collection: component_parts,
          as: :component_part,
          locals: { component: component }
        )
      %>
    </div>
  <% end %>
</div>
