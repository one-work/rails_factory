<label
  for="part_<%= component_part.part_id %>"
  class="button overflow-x-hidden is-checked"
>
  <span class="truncate"><%= component_part.part.title_short %></span>
  <span class="flex-shrink-0">
    <% if component_part.part.price.to_d > 0 %>
      <span class="text-danger ml-1"><%= component_part.part.price.to_money.format.html_safe %></span>
    <% end %>
    <% if component.cancelable?(@production.production_parts, component_part.part_id) %>
      <%= svg_tag 'xmark', class: 'icon is-small ml-1' %>
    <% end %>
  </span>
  <% if component.only_one? %>
    <%=
      hidden_field_tag(
        "production_parts_attributes[#{component.id}][component_id]",
        component_part.component_id,
        form: 'edit_custom',
        id: nil
      )
    %>
    <%=
      radio_button_tag(
        "production_parts_attributes[#{component.id}][part_id]",
        component_part.part_id,
        @production.is_checked?(component_part),
        data: {
          action: 'custom#toggle click->custom#tip',
          part_taxon_id: component.part_taxon_id,
          disabled: component.no_cancel?(@production.production_parts, component_part.part_id)
        },
        class: 'display-none',
        id: "part_#{component_part.part_id}",
        form: 'edit_custom'
      )
    %>
  <% else %>
    <%=
      hidden_field_tag(
        "production_parts_attributes[#{component_part.id}][component_id]",
        component_part.component_id,
        form: 'edit_custom',
        id: nil
      )
    %>
    <%=
      hidden_field_tag(
        "production_parts_attributes[#{component_part.id}][part_id]",
        component_part.part_id,
        form: 'edit_custom',
        data: { part_taxon_id: component_part.part.taxon_id },
        id: nil
      ) if @production.no_cancel(component, component_part)
    %>
    <%=
      check_box_tag(
        "production_parts_attributes[#{component_part.id}][part_id]",
        component_part.part_id,
        @production.is_checked?(component_part),
        data: {
          action: 'custom#toggle',
          part_taxon_id: component.part_taxon_id
        },
        disabled: component.no_cancel?(@production.production_parts, component_part.part_id),
        class: 'display-none',
        id: "part_#{component_part.part_id}",
        form: 'edit_custom'
      )
    %>
  <% end %>
</label>
