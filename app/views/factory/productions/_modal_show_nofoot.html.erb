<div
  id="modal_change"
  data-controller="modal"
  class="modal is-mobile is-active"
>
  <div data-action="click->modal#close" class="modal-background has-animate-fade-in"></div>
  <div class="modal-card">
    <header class="modal-card-head as-bar">
      <span class="left"></span>
      <p class="bar-title"><%= @production.product.name %></p>
      <button type="button" data-action="modal#close" class="button is-borderless left">
        <%= svg_tag 'xmark' %>
      </button>
    </header>
    <div id="production_modal_body" class="modal-card-body">
      <%= yield %>
    </div>
    <%= render partial: 'modal_foot_component', locals: { item_con: "trade/#{params[:namespace].presence || 'my'}/items" } %>
  </div>
</div>
