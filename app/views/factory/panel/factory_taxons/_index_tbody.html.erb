<td>
  <%= link_to({ controller: 'taxons', factory_taxon_id: model.id }, class: 'is-several') do %>
    <%= image_tag model.logo, class: 'image is-24x24' if model.logo.attached? %>
    <span><%= model.name %></span>
  <% end %>
</td>
<td><%= model.scene&.title %></td>
<td>
  <%= link_to({ controller: 'factory_providers', factory_taxon_id: model.id }, aria: { label: t('factory.panel.factory_providers.index.title') }, class: 'button is-small is-borderless') do %>
    <%= svg_tag 'industry' %>
    <span><%= model.factory_providers_count %></span>
  <% end %>
</td>
