<div id="modal_change" data-controller="modal" class="modal is-active">
  <div data-action="click->modal#close" class="modal-background has-animate-fade-in"></div>
  <div class="modal-card">
    <header class="modal-card-head">
      <p class="modal-card-title"><%= @production.product.name %></p>
      <button type="button" data-action="modal#close" class="delete"></button>
    </header>
    <div id="production_modal_body" class="modal-card-body">
      <%= form_with model: @production, scope: '', url: { action: 'create_dialog' }, id: 'edit_custom' do |f| %>
        <%= hidden_field_tag :component_id, id: nil %>
      <% end %>
      <%= render partial: 'production_card_components', locals: { production: @production } %>
    </div>
    <%= render partial: 'modal_foot_purchase_component', locals: { item_con: item_con } %>
  </div>
</div>
