<tr id="tr_<%= model.product_id %>_<%= model.id %>" data-id="<%= model.id %>">
  <td colspan="6">
    <div id="product_cart_<%= model.product_id %>" class="right-badge">
      <%=
        button_to(
          { controller: 'factory/in/productions', action: 'show', id: model.id },
          class: 'button is-small is-primary'
        ) do
      %>
        <%= svg_tag 'cart-plus', class: 'icon' %>
        <span>定制产品</span>
      <% end %>
    </div>
  </td>
</tr>
