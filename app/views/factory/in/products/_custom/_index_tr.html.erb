<% if model.productions_count > 1 %>
  <%= tr_tag(model, icons: [], class: 'background-light') { yield } %>
<% end %>

<% @cart.find_purchase_items(model.id).each do |purchase, items| %>
  <%= render partial: 'production_item', locals: { purchase: purchase, size: items.size + 1 } %>
  <%= render partial: 'item_purchase_tbody', layout: 'item_tr', collection: items, as: :item %>
<% end %>

<%= render partial: 'production_tr', locals: { model: model.production } %>
