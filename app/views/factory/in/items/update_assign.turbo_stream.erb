<%= turbo_stream.remove_all "data-product-id=#{@item.collect_id}" %>
<%= turbo_stream.remove 'modal_form' %>

<%= turbo_stream.after "tr_#{@item.collect_id}" do %>
  <%= render partial: 'production_item_purchase', locals: { purchase: @item.purchase, size: @items.size + 1 } %>
  <%= render partial: 'item_purchase_tbody', layout: 'item_purchase_tr', collection: @items, as: :item %>
<% end %>
