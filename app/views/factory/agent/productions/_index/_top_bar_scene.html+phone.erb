<%= render layout: 'top_bar_left' do %>
  <div class="bar-title">
    <div>
      <span class="text-weight-semibold"><%= params[:produce_on] %></span>
      <span><%= params[:produce_on].to_date.to_fs(:week) if params[:produce_on].present? %></span>
    </div>
    <div>
      <span class="text-weight-semibold"><%= @scene.title %></span>
    </div>
  </div>
  <%= button_to({ action: 'preview' }, params: params.permit(:contact_id), class: 'text-link', form: { class: 'right' }) do %>
    <span>选择场景</span>
    <%= svg_tag 'angle-right' %>
  <% end %>
<% end %>
