<div class="media as-boxed">
  <div class="media-left">
  <% if model.logo.attached? %>
    <%= image_tag model.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' %>
  <% else %>
    <%= image_tag 'product_default.jpg', class: 'image is-64x64' %>
  <% end %>
  </div>
  <div class="media-content">
    <p><%= model.title %></p>
    <p class="text-danger mt-1"><%= model.price.to_money.format.html_safe %></p>
  </div>
  <div class="media-right">
    <%= yield %>
  </div>
</div>
