<div class="media as-boxed">
  <% if model.can_select? %>
  <div class="media-left">
  <% if model.logo.attached? %>
    <%= image_tag model.logo.variant(resize_to_limit: [64, 64]), class: 'image is-radius is-64x64' %>
  <% else %>
    <%= image_tag 'product_default.jpg', class: 'image is-radius is-64x64' %>
  <% end %>
  </div>
  <% end %>
  <div class="media-content">
    <div class="is-several">
      <% unless model.can_select? %>
        <% if model.logo.attached? %>
          <%= image_tag model.logo.variant(resize_to_limit: [24, 24]), class: 'image is-radius is-24x24' %>
        <% end %>
      <% end %>
      <span><%= model.title %></span>
    </div>
    <p class="text-danger mt-1"><%= model.price.to_money.format.html_safe %></p>
  </div>
  <div class="media-right">
    <%= yield %>
  </div>
</div>
