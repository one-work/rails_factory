<div
  id="modal_change"
  data-controller="modal"
  class="modal is-mobile is-mobile-bottom is-active"
>
  <div data-action="click->modal#close" class="modal-background has-animate-fade-in"></div>
  <div class="modal-card has-animate-slide-up">
    <header class="modal-card-head as-bar">
      <button type="button" data-action="modal#close" class="button is-borderless left">
        <%= svg_tag 'xmark' %>
      </button>
      <p class="bar-title"><%= @production.product.name %></p>
      <i class="right"></i>
    </header>
    <div id="production_modal_body" class="modal-card-body is-narrow">
      <%= yield %>
    </div>
    <% if @production.taxon.customizable %>
      <%= render partial: 'modal_foot_component', locals: { item_con: item_con } %>
    <% else %>
      <%= render partial: 'modal_foot_brothers', locals: { item_con: item_con } %>
    <% end %>
  </div>
</div>
