<% if @product.taxon.customizable %>
  <%= button_to({ action: 'new_part', **request.GET.except(:id) }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'plus' %>
    <span><%= t('.new_part.title') %></span>
  <% end %>
<% else %>
  <%= button_to({ action: 'new', **request.GET.except(:id) }, class: 'button is-rounded is-primary') do %>
    <%= svg_tag 'plus' %>
    <span><%= t('.new.title') %></span>
  <% end %>
<% end %>
