<div class="modal-card">
  <%= render 'modal_header' %>
  <section id="modal-card-body" class="modal-card-body">
    <%= form_with model: @production, scope: '', url: { action: 'create_dialog' }, id: 'edit_custom' do |f| %>
      <% params.permit(:desk_id, :station_id, :client_id, :contact_id).each do |k, v| %>
        <%= f.hidden_field k, value: v %>
      <% end %>
      <%= hidden_field_tag :component_id, id: nil %>
    <% end %>
    <%= render partial: 'production_card_components', locals: { production: @production } %>
  </section>
  <footer class="modal-card-foot">
    <%= submit_tag %>
  </footer>
</div>
