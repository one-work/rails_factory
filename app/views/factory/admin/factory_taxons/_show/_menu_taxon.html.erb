<div class="menu as-side mr-3">
  <div class="menu-list is-sticky">
    <% @taxons.each do |taxon| %>
      <%=
        link_to(
          taxon.name,
          { controller: 'factory_taxon/products', factory_taxon_id: @factory_taxon.id, taxon_id: taxon.id },
          data: { turbo_action: 'replace' },
          class: active_helper(taxon_id: taxon.id, item: 'menu-item', active: 'menu-item is-active')
        )
      %>
    <% end %>
    <div class="background-white flex-grow-1"></div>
  </div>
</div>
