<div id="tr_<%= model.id %>" class="media">
  <% if model.logo.attached? %>
    <div class="media-left">
      <%= image_tag model.logo.variant(resize_to_limit: [64, 64]), class: 'image is-64x64' %>
    </div>
  <% end %>
  <%= link_to({ action: 'show', id: model.id }, text: true, class: 'media-content') do %>
    <%= yield %>
  <% end %>
  <div class="media-right">
  <% if @select_ids.include?(model.id) %>
    <%=
      button_to(
        { action: 'copy' },
        params: { product_id: model.id },
        aria: { label: t('.copy.title') },
        class: 'button is-small is-borderless'
      ) do
    %>
      <%= svg_tag 'tractor' %>
    <% end %>
  <% else %>
    <span>
     <%= svg_tag 'check', class: 'icon is-small text-success' %>
     <span>已导入</span>
    </span>
  <% end %>
  </div>
</div>
