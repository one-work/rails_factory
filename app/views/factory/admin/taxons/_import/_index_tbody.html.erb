<td>
  <div class="is-several">
    <%= image_tag model.logo, class: 'image is-24x24' if model.logo.attached? %>
    <span><%= model.name %></span>
  </div>
  <span class="tag"><%= model.organ.name %></span>
</td>
<td>
  <table class="table is-borderless">
  <% model.parts.each do |part| %>
    <tr>
      <td>
        <span class="tag">
          <%= link_to part.word, { controller: 'products', action: 'show', taxon_id: part.taxon_id, id: part.id } %>
        </span>
      </td>
    </tr>
  <% end %>
  </table>
</td>
<td>
<% if @select_ids.include?(model.id) %>
  <%= svg_tag 'check', class: 'icon is-small text-success' %>
<% else %>
  <%= svg_tag 'xmark' %>
<% end %>
</td>
