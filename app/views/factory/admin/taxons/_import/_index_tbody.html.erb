<td>
  <div class="is-several">
    <%= image_tag model.logo.variant(resize_to_limit: [24, 24]), class: 'image is-24x24' if model.logo.attached? %>
    <span><%= model.name %></span>
  </div>
  <span class="tag"><%= model.organ.name %></span>
</td>
<td colspan="2"></td>
<td>
<% if @select_ids.include?(model.id) %>
  <%= svg_tag 'check', class: 'icon is-small text-success' %>
<% else %>
  <%= svg_tag 'xmark' %>
<% end %>
</td>
