<td>
  <div class="is-several pl-4">
    <span><%= model.word %></span>
    <span class="text-danger ml-1"><%= model.price.to_money.format.html_safe %></span>
  </div>
</td>
<td>
  <div class="tags">
  <% model.parts.each do |part| %>
    <span class="tag">
      <%= link_to part.word, { controller: 'products', action: 'show', taxon_id: part.taxon_id, id: part.id } %>
    </span>
  <% end %>
  </div>
</td>
<td>
<% if @imported_production_ids.include?(model.id) %>
  <%= svg_tag 'check', class: 'icon is-small text-success' %>
  <%=
    button_to(
      { action: 'prune' },
      method: :delete,
      params: { production_id: model.id },
      aria: { label: t('factory.in.taxons.prune.title') },
      class: 'button is-small is-borderless'
    ) do
  %>
    <%= svg_tag 'xmark', class: 'icon is-small text-danger' %>
  <% end %>
<% else %>
  <%=
    button_to(
      { action: 'copy' },
      params: { production_id: model.id },
      aria: { label: t('factory.in.taxons.copy.title') },
      class: 'button is-small is-borderless'
    ) do
  %>
    <%= svg_tag 'tractor' %>
  <% end %>
<% end %>
</td>
