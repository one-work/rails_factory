<div>
  <dt><%= Factory::Taxon.human_attribute_name(:name) %></dt>
  <dd><%= @taxon.name %></dd>
</div>
<% if @taxon.factory_taxon %>
<div>
  <dt><%= Factory::Taxon.human_attribute_name(:factory_taxon_id) %></dt>
  <dd><%= @taxon.factory_taxon.name %></dd>
</div>
<% end %>
<div>
  <dt><%= Factory::Taxon.human_attribute_name(:position) %></dt>
  <dd><%= @taxon.position %></dd>
</div>
<div>
  <dt><%= Factory::Taxon.human_attribute_name(:logo) %></dt>
  <dd><%= image_tag @taxon.logo, class: 'image is-64x64' if @taxon.logo.attached? %></dd>
</div>
<div>
  <dt><%= Factory::Taxon.human_attribute_name(:logo_color) %></dt>
  <dd><%= image_tag @taxon.logo_color, class: 'image is-64x64' if @taxon.logo_color.attached? %></dd>
</div>
<div>
  <dt><%= Factory::Taxon.human_attribute_name(:products_count) %></dt>
  <dd><%= @taxon.products_count %></dd>
</div>
