<div
  data-controller="picture-select"
  data-picture-select-id-value="product_logo"
  class="cards is-2"
>
<% @logos.each do |logo| %>
  <div class="card">
    <div
      data-action="click->picture-select#select"
      data-value="<%= logo.media.blob.signed_id %>"
      data-url="<%= logo.media.blob.url %>"
      class="card-image"
    >
      <%= image_tag logo.media, class: 'image' %>
    </div>
  </div>
<% end %>
</div>
