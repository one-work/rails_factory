<td>
  <%= button_to model.word, { controller: 'productions', action: 'show', product_id: model.product_id, id: model.id } %>
</td>
<td>
  <% model.production_parts.each do |production_part| %>
    <%= button_to({ controller: 'productions', action: 'show', product_id: production_part.part.product_id, id: production_part.part_id }, class: 'tag is-info') do %>
      <span><%= production_part.part.word %></span>
      <span class="ml-1"><%= production_part.part.price.to_money.format.html_safe %></span>
    <% end %>
  <% end %>
</td>
<td><%= model.price.to_money.format.html_safe %></td>
<td>
  <table>
    <tbody id="production_<%= model.id %>">
    <% model.available_provides.each do |production_provide| %>
      <tr id="production_provide_<%= production_provide.id %>">
        <td><%= production_provide.provide.name %></td>
        <td><%= production_provide.cost_price.to_money.format.html_safe %></td>
        <td>
          <%=
            button_to(
              { controller: 'taxon/production_provides', action: 'edit', taxon_id: model.taxon_id, id: production_provide.id },
              class: 'button is-small is-borderless'
            ) do
          %>
            <%= svg_tag 'pencil' %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</td>
<td>
  <div data-show-target="item" class="visibility-hidden">
    <%=
      button_to(
        { controller: 'production_provides', action: 'new', production_id: model.id },
        class: 'button is-small is-borderless'
      ) do
    %>
      <%= svg_tag 'pencil' %>
      <span><%= t('.production_provides.new.title') %></span>
    <% end %>
  </div>
</td>
