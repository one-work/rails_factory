<div class="level box sticky-bottom mt-3 background-grey-light">
  <div class="level-left">
    <%= render partial: 'cart_nav_purchase', locals: { cart: @cart } %>
  </div>
  <div class="level-right">
    <%=
      link_to(
        { controller: 'trade/in/orders', action: 'cart', current_cart_id: @cart.id, **params.permit!.slice('factory_taxon_id') },
        class: 'button is-info'
      ) do
    %>
      <%= svg_tag 'credit-card' %>
      <span class="ml-1"><%= t('factory.in.orders.new.title') %></span>
    <% end %>
  </div>
</div>
