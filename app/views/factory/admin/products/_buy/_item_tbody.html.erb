<td>
  <%= render partial: 'purchase_cart', locals: { item_con: 'trade/in/items', cart: @cart, item: item } %>
</td>
<td>
  <span><%= item.provide&.name %></span>
  <% if item.available_provide %>
    <span class="tag">默认供应商</span>
  <% else %>
    <span class="tag">临时供应商</span>
  <% end %>
</td>
<td><%= item.single_price.to_money.format.html_safe %></td>
