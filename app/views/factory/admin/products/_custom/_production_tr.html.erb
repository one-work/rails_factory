<% items = @cart.init_provide_items(model) %>

<tr id="tr_<%= model.product_id %>_<%= model.id %>" data-id="<%= model.id %>">
  <td rowspan="<%= items.size + 1 %>">
    <span class="<%= model.product.productions_count > 1 ? 'ml-4' : 'ml-0' %>">
      <% model.production_parts.includes(:part).each do |production_part| %>
        <span class="tag"><%= production_part.part.title_short %></span>
      <% end %>
    </span>
  </td>
  <td rowspan="<%= items.size + 1 %>">
    <p class="text-grey"><%= model.price.to_money.format.html_safe %></p>
  </td>
  <td rowspan="<%= items.size + 1 %>">
    <p class="text-danger"><%= model.cost_price.to_money.format.html_safe %></p>
  </td>
</tr>
<%=
  render(
    partial: 'item_tbody',
    layout: 'item_tr',
    collection: items,
    as: :item
  )
%>
