<div id="tr_<%= model.id %>" class="media">
  <div class="media-content">
    <%= yield %>
  </div>
  <div class="media-right">
    <%=
      button_to(
        { controller: 'productions', action: 'actions', product_id: model.product_id, id: model.id },
        class: 'button is-borderless'
      ) do
    %>
      <%= svg_tag 'ellipsis-vertical' %>
    <% end %>
  </div>
</div>
