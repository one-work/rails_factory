<td>
<% if model.provide %>
  <%= model.provide.name %>
<% else %>
<% end %>
</td>
<td>
<% if model.provide %>
  <%= model.provide.provider.name %>
<% end %>
</td>
<td>
<% if model.upstream_product %>
  <span><%= model.upstream_product.name %></span>
<% end %>
</td>
<td>
  <%= form_with theme: 'switch', model: model, url: { controller: 'product_provides', action: 'refresh', id: model.id }, data: { controller: 'input' } do |f| %>
    <%= f.checkbox :default, data: { action: 'input#submit' }, id: nil %>
  <% end %>
</td>
<td><time data-controller="time"><%= model.created_at.to_fs(:iso8601) %></time></td>
