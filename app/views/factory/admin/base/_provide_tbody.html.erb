<td><%= model.name %></td>
<td colspan="2">
<% if model.provider %>
  <div class="is-several">
    <%= image_tag model.provider.logo, class: 'image is-rounded is-24x24' if model.provider.logo.attached? %>
    <span><%= model.provider.name %></span>
  </div>
<% else %>
  <%= button_to({ controller: 'provides', action: 'invite', id: model.id }, class: 'button is-small is-borderless') do %>
    <%= svg_tag 'user-plus' %>
    <span><%= t('.taxon.provides.invite.title') %></span>
  <% end %>
<% end %>
</td>
<td></td>
<td><time data-controller="time"><%= model.created_at.to_fs(:iso8601) %></time></td>
