<div class="as-bar">
  <button
    id="history-button"
    data-controller="history"
    data-history-url-value="<%= url_for(controller: '/org/organs', host: Current.session.from_organ.host) %>"
    data-action="history#back"
    class="px-4"
  >
    <%= svg_tag 'angle-left', kind: 'regular' %>
    <% if params[:dispatch] == 'delivery' && current_user.address_principal %>
      <span class="text-grey"><%= current_user.address_principal.detail %></span>
    <% end %>
  </button>
  <div class="bar-title"><%= t('.title', default: '') %></div>
  <div class="tabs is-toggle is-toggle-rounded is-small pr-3">
    <ul>
      <li class="<%= active_helper(dispatch: (['fetch', 'dine'] & [params[:fetch]]).fetch(0, 'dine'), active: 'is-active') %>">
        <%= link_to('预点单', { dispatch: (['fetch', 'dine'] & [params[:fetch]]).fetch(0, 'dine') }, data: { turbo_action: 'replace' }) %>
      </li>
      <li class="<%= active_helper(dispatch: 'delivery', active: 'is-active') %>">
        <%= link_to('外卖', { dispatch: 'delivery' }, data: { turbo_action: 'replace' }) %>
      </li>
    </ul>
  </div>
</div>
