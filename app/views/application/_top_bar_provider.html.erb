<div class="as-bar">
  <%= link_to({ controller: '/org/organs', host: Current.session.from_organ.host }, class: 'px-4') do %>
    <%= svg_tag 'angle-left', kind: 'regular' %>
  <% end %>
  <div class="bar-title"><%= t('.title', default: '') %></div>
  <div class="tabs is-toggle is-toggle-rounded is-small pr-3">
    <ul>
      <li class="<%= active_helper(dispatch: 'fetch', active: 'is-active') %>">
        <%= link_to('打包', { dispatch: 'fetch' }, data: { turbo_action: 'replace' }) %>
      </li>
      <li class="<%= active_helper(dispatch: 'delivery', active: 'is-active') %>">
        <%= link_to('外卖', { dispatch: 'delivery' }, data: { turbo_action: 'replace' }) %>
      </li>
    </ul>
  </div>
</div>
