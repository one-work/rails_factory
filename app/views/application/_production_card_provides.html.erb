<div data-controller="custom" class="grid gap-2 as-actions">
<% production.available_provides.each do |production_provide| %>
  <label for="provide_id_<%= production_provide.provide_id %>" class="cell button is-fullwidth is-checked">
    <%=
      radio_button_tag(
        :provide_id,
        production_provide.provide_id,
        production_provide.provide_id == params[:provide_id].presence,
        data: { action: 'custom#submit' },
        class: 'display-none',
        form: 'edit_custom'
      )
    %>
    <p><%= production_provide.provide.name %></p>
  </label>
<% end %>
</div>
