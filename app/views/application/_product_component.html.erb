<div
  id="product_componnet_<%= item.id %>"
  class="radius-small"
  style="background-color: <%= item.attributes.slice('good_id', 'dispatch') == refer_options.slice('good_id', 'dispatch') ? '#eee' : 'auto' %>"
>
  <dt class="truncate flex-shrink-1">
    <ul class="media-info display-inline-flex">
      <% item.good.production_parts.includes(:part).each do |production_part| %>
        <li>
          <span><%= production_part.part.word %></span>
          <span>x</span>
          <span><%= production_part.number %></span>
        </li>
      <% end %>
      <li class="text-danger"><%= item.dispatch_i18n %></li>
    </ul>
  </dt>
  <dd class="text-right flex-shrink-0">
    <%= yield %>
  </dd>
</div>
