<div data-controller="custom" class="grid gap-2 as-actions">
<% production.organ.dispatch_options(**params.permit(:desk_id, :dispatch), **session.to_h.slice('desk_id')).each do |value| %>
  <label for="dispatch_<%= value %>" class="cell button is-fullwidth is-checked">
    <%=
      radio_button_tag(
        'dispatch',
        value,
        value.to_s == params[:dispatch].presence,
        data: { action: 'custom#submit' },
        class: 'display-none',
        form: 'edit_custom'
      )
    %>
    <p><%= Trade::Item.enum_i18n(:dispatch, value) %></p>
  </label>
<% end %>
</div>
