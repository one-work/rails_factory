<dl
  id="product_summary_<%= model.product_id %>"
  class="as-show is-fullwidth p-0 is-interval"
>
  <%=
    render(
      partial: 'cart_item_new',
      layout: 'product_component',
      collection: cart.find_items(model.brother_ids, good_type: model.base_class_name, **options),
      locals: {
        item: @cart.init_cart_item(params.permit(:xx), dispatch: item.dispatch, good_id: item.good_id),
        cart: @cart,
        item_con: item_con,
        renew: {
          "product_summary_#{model.product_id}" => 'product_summary_component',
          "product_cart_#{model.product_id}" => 'production_cart'
        },
        renew_options: {
          production_cart: { controller: controller_path, **params.permit(:client_id) }
        },
        refer_options: refer_options
      }
    )
  %>
</dl>
