<dl id="product_summary_<%= model.product_id %>" class="as-show is-fullwidth p-0 is-interval">
  <%=
    render(
      partial: 'cart_item_new',
      layout: 'product_summary_brother',
      collection: cart.find_items(model.brother_ids, good_type: model.base_class_name),
      as: :item,
      locals: {
        cart: cart,
        item_con: item_con,
        order_con: 'trade/my/orders',
        renew: {
          "product_cart_#{model.product_id}" => { 'partial' => 'production_cart' }
        },
        renew_options: {
          production_cart: { controller: controller_path, **params.permit(:client_id) }
        },
        refer_options: refer_options,
        remove: 'product_summary_brother'
      }
    )
  %>
</dl>
