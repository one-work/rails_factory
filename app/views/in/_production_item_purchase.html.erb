<tr id="tr_<%= purchase.product_id %>_<%= purchase.id %>" data-product-id="<%= purchase.product_id %>">
  <td rowspan="<%= size %>">
    <span class="<%= purchase.product.productions_count > 1 ? 'ml-4' : 'ml-0' %>">
      <% purchase.production_parts.includes(:part).each do |production_part| %>
        <span class="tag"><%= production_part.part.title_short %></span>
      <% end %>
    </span>
  </td>
  <td rowspan="<%= size %>">
    <p class="text-grey"><%= purchase.price.to_money.format.html_safe %></p>
  </td>
  <td rowspan="<%= size %>">
    <p class="text-danger"><%= purchase.cost_price.to_money.format.html_safe %></p>
  </td>
</tr>
